#!/usr/bin/env python3
"""agy-effortless: liga/desliga e ajusta o effortless do agy-turbo.

  agy-effortless                 status
  agy-effortless on|off          seleção automática de esforço
  agy-effortless judge auto|flash|local   auto (padrão): Flash só quando as regras locais estão em dúvida
  agy-effortless floor|ceiling low|medium|high|xhigh|max
  agy-effortless bias -2..2      empurra decisões incertas para baixo/cima
  agy-effortless economy on|off  nunca acima de medium
  agy-effortless resubmit on|off subir esforço reenviando a mensagem (vale já)
  agy-effortless compact auto|suggest|off   compactar sozinho no fim do turno quando o contexto enche
  agy-effortless compact-at 80             % de contexto para compactar
  agy-effortless handoff suggest|auto|off  troca de assunto com contexto grande
  agy-effortless reset           volta ao padrão
"""
import json, os, sys
DATA = os.environ.get("AGY_TURBO_DATA") or os.path.expanduser("~/.gemini/antigravity-cli/plugin_data/agy-turbo")
LEVELS = ["low", "medium", "high", "xhigh", "max"]
CFG = os.path.join(DATA, "config.json")
def load(p):
    try:
        return json.load(open(p))
    except (OSError, ValueError):
        return {}
def save(c):
    os.makedirs(DATA, exist_ok=True)
    json.dump(c, open(CFG, "w"), indent=1)
a = sys.argv[1:]
c = load(CFG)
onoff = {"on": True, "off": False}
try:
    if not a or a[0] == "status":
        pass
    elif a[0] in onoff:
        c["auto"] = onoff[a[0]]
    elif a[0] == "judge" and a[1] in ("auto", "flash", "local"):
        c["judge"] = a[1]
    elif a[0] in ("floor", "ceiling") and a[1] in LEVELS:
        c[a[0]] = a[1]
    elif a[0] == "bias" and a[1].lstrip("-") in "012" and -2 <= int(a[1]) <= 2:
        c["bias"] = int(a[1])
    elif a[0] in ("economy", "resubmit") and a[1] in onoff:
        c[a[0]] = onoff[a[1]]
    elif a[0] in ("compact", "handoff") and a[1] in ("auto", "suggest", "off"):
        c[a[0]] = a[1]
    elif a[0] in ("compact-at", "handoff-at") and a[1].isdigit() and 10 <= int(a[1]) <= 95:
        c[a[0].replace("-", "_")] = int(a[1])
    elif a[0] == "reset":
        c = {}
    else:
        sys.exit(__doc__)
except IndexError:
    sys.exit(__doc__)
if a and a[0] != "status":
    save(c)
st = load(os.path.join(DATA, "effortless.json"))
eff = {"auto": True, "judge": "auto", "floor": "low", "ceiling": "max", "bias": 0, "economy": False, "resubmit": True,
       "compact": "auto", "compact_at": 80, "handoff": "suggest", "handoff_at": 40}
eff.update(c)
print("effortless: " + ("auto" if eff["auto"] else "desligado") + f" · juiz {eff['judge']} · piso {eff['floor']} · "
      f"teto {eff['ceiling']} · viés {eff['bias']} · economia {'on' if eff['economy'] else 'off'} · "
      f"reenviar {'on' if eff['resubmit'] else 'off'}\n"
      f"compact {eff['compact']} a {eff['compact_at']}% · handoff {eff['handoff']} a partir de {eff['handoff_at']}%")
j = st.get("judge") or {}
if j:
    print("juiz: " + (f"{j.get('effort')} em {j.get('ms', 0) / 1000:.1f}s ({j.get('reason', '')})" if j.get("ok")
                      else f"sem resposta ({j.get('ms', 0) / 1000:.1f}s)"))
if st.get("decided"):
    print(f"última decisão: {st.get('current')} -> {st['decided']} ({st.get('reason', '')})")
